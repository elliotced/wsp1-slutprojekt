<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RubySong - <%= @current_page %></title>
  <link rel="stylesheet" href="/style.css?<%= Time.now.to_i %>">
</head>
<body>
  <div class="app">

    <aside class="sidebar">
      <div class="sidebar-header">
        <h1 class="logo">RubySong</h1>
        <% if @account %>
          <h2>Logged in as:</h2>
          <h2><%= @account["name"]%></h2>
          <h2><%= @account["type"]%></h2> 
        <% else %>
          <h2>Not logged in</h2>
        <% end %>
      </div>
      <nav>
        <a href="/"        class="nav-item">Home</a>
        <a href="/genres"   class="nav-item">Genres</a>
        <a href="/songs"   class="nav-item">Songs</a>
        <a href="/accounts" class="nav-item">Account</a>
      </nav>
    </aside>

    <main class="content">
      <header class="content-header">
        <h2><%= @current_page %></h2>
      </header>
      <section class="content-body">
        <%= yield %>
      </section>
    </main>

  </div>
</body>
</html>
